SITE_DOMAIN=news.example.in
MONGO_USER=wakeupindia
# Use a long random password containing only URL-safe letters and numbers.
MONGO_PASSWORD=replace-with-long-random-value
ADMIN_EMAIL=admin@example.in
ADMIN_PASSWORD=replace-with-a-unique-strong-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

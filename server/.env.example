PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/kraantiinfo
NEWS_ENGINE_ENABLED=true
NEWS_COLLECTION_INTERVAL_MINUTES=30
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters in production.
JWT_SECRET=
# Configure provider credentials here on the server only.
# NEWSDATA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,dots-studio/dots-3-note-preview:free
# Creates at most one AI-selected article per collection cycle.
AI_AUTO_PROCESSING_ENABLED=true
AI_AUTO_PROCESSING_COOLDOWN_HOURS=12
# Scheduled AI drafts can be written in Hindi (hi) or English (en); defaults to Hindi.
AI_AUTO_DRAFT_LANGUAGE=hi
# Automatic publishing is off by default unless both explicit opt-ins are true.
AI_AUTO_PUBLISH_ENABLED=true
# Turning this on allows publication without a human editor. Keep false for review-first publishing.
AI_AUTO_PUBLISH_WITHOUT_HUMAN_REVIEW=false

# Optional Blogger syndication: already-published KraantiInfo articles are
# automatically published to this Blogger blog when credentials are configured.
BLOGGER_AUTO_PUBLISH_ENABLED=false
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
PUBLIC_SITE_URL=https://kraantiinfo.vercel.app



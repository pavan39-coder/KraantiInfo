{
  "name": "kraantiinfo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev --workspace=@kraantiinfo/server\" \"npm run dev --workspace=@kraantiinfo/client\"",
    "dev:server": "npm run dev --workspace=@kraantiinfo/server",
    "dev:client": "npm run dev --workspace=@kraantiinfo/client",
    "build": "npm run build --workspace=@kraantiinfo/client",
    "test": "npm run test --workspace=@kraantiinfo/server",
    "check": "npm run test && npm run build",
    "start": "npm run start --workspace=@kraantiinfo/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}

